{
  "info": {
    "name": "Smart Durian Farm — Backend PDF 24-10",
    "description": "Nhập JSON trực tiếp. Thay host/port nếu khác. Mỗi request: tự thay placeholder PHONE/PASSWORD/JWT/UUID/OTP, không dùng scripts hoặc environment. JWT collection đặt thủ công ở Authorization. OTP chỉ gửi khi bạn chủ động gọi; không chạy cả collection hàng loạt. Đăng nhập/quên mật khẩu chấp nhận 0, 84 hoặc +84 cùng tài khoản; số lưu không đổi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "DAN_JWT_VAO_DAY",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Đăng nhập và phiên",
      "item": [
        {
          "name": "Đăng nhập bằng 0 hoặc +84",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "http://localhost:3000/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"SO_DIEN_THOAI_DA_DANG_KY\",\n  \"password\": \"MAT_KHAU_CUA_BAN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Xem tài khoản hiện tại",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/api/auth/me"
          },
          "response": []
        },
        {
          "name": "Gia hạn khi thao tác — JWT phải còn hạn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:3000/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
