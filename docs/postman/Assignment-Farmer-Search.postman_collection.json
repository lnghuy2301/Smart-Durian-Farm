{
  "info": {
    "name": "Assignment - Farmer name and phone search",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual JWT/UUID/phone entry. Owner/Admin lookup; switch to assignee JWT for acceptance. No scripts or environments."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "PASTE_OWNER_OR_ADMIN_JWT",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 - Previous accepted workers in this Farm",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:3000/api/zones/ZONE_UUID/assignment-candidates"
      }
    },
    {
      "name": "2 - Find by name",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:3000/api/zones/ZONE_UUID/assignment-candidates?q=Nguyen"
      }
    },
    {
      "name": "3 - Find by phone (replace example)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:3000/api/zones/ZONE_UUID/assignment-candidates?q=0900000002"
      }
    },
    {
      "name": "4 - Invite selected UUID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://127.0.0.1:3000/api/zones/ZONE_UUID/assignment-requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"FARMER_UUID\",\n  \"end_date\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5 - Assignee accepts (Admin proposals also need owner approval)",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "PASTE_FARMER_JWT",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://127.0.0.1:3000/api/assignment-requests/REQUEST_UUID/approve",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
