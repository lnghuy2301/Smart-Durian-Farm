# Separate server file: /etc/smart-durian/api.env (0600, service-readable).
# Do not replace the developer's local .env or copy private account notes here.
NODE_ENV=production
AUTH_MODE=database
BUSINESS_STORAGE=database
API_HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=https://farm.example.com
TRACE_PUBLIC_BASE_URL=https://farm.example.com
DATABASE_URL=
MONGODB_URI=
DB_TIMEOUT_MS=10000
JWT_SECRET=
# Disabled fails closed. Switch to twilio only after filling credentials/allowlists.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_HTX_VERIFY_SERVICE_SID=
SMS_ALLOWED_PHONE=
HTX_SMS_ALLOWED_PHONES=
LIVE_SMS_ENABLED=false
SMS_TIMEOUT_MS=10000
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_OFFLINE_AFTER_MS=1800000
MQTT_RECONNECT_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000
ACTUATOR_ACK_TIMEOUT_MS=10000
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8001
AI_INTERNAL_TOKEN=
AI_CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_OUTPUT_TOKENS=4096
