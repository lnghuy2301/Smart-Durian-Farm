{
  "name": "@smart-durian/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "npm run build && concurrently -k \"tsc -p tsconfig.build.json --watch\" \"node --watch --watch-preserve-output dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:acceptance": "npm run build && node dist/ai/pre-acceptance-cli.js",
    "lint": "eslint src test integration",
    "test": "tsc --outDir .test-dist && node --test --test-concurrency=2 .test-dist/test",
    "test:integration": "tsc --outDir .integration-dist && node --test .integration-dist/integration/database.integration.js",
    "db:status": "npm run build && node dist/persistence/cli.js status",
    "db:migrate": "npm run build && node dist/persistence/cli.js migrate",
    "db:data:expand": "npm run build && node dist/persistence/rich-data-cli.js",
    "db:cultivation:preview": "npm run build && node dist/persistence/cultivation-enrichment-cli.js preview",
    "db:cultivation:expand": "npm run build && node dist/persistence/cultivation-enrichment-cli.js apply",
    "db:materials:expand": "npm run build && node dist/persistence/material-catalog-cli.js",
    "db:data:preview": "npm run build && node dist/persistence/operational-data-cli.js preview",
    "db:data:refresh": "npm run build && node dist/persistence/operational-data-cli.js apply",
    "db:seed": "npm run build && node dist/persistence/cli.js seed",
    "db:demo:prepare": "npm run build && node dist/persistence/demo-telemetry-cli.js prepare",
    "db:seed:telemetry": "npm run build && node dist/persistence/demo-telemetry-cli.js",
    "db:backup": "npm run build && node dist/persistence/backup-cli.js create",
    "db:demo:check": "npm run build && node dist/persistence/backup-cli.js demo-check",
    "db:backup:verify": "npm run build && node dist/persistence/backup-cli.js verify",
    "db:restore:check": "npm run build && node dist/persistence/backup-cli.js restore-check",
    "db:restore:new": "npm run build && node dist/persistence/backup-cli.js restore-new",
    "test:persistence": "tsc --outDir .integration-dist && node --test --test-concurrency=1 .integration-dist/integration/persistence.integration.js .integration-dist/integration/users-auth.integration.js .integration-dist/integration/users-cooperatives.integration.js .integration-dist/integration/cooperative-workflows.integration.js .integration-dist/integration/catalogs.integration.js .integration-dist/integration/farm-workflows.integration.js .integration-dist/integration/zone-workflows.integration.js .integration-dist/integration/assignment-workflows.integration.js .integration-dist/integration/tree-workflows.integration.js .integration-dist/integration/harvest-workflows.integration.js .integration-dist/integration/device-workflows.integration.js .integration-dist/integration/sensor-workflows.integration.js .integration-dist/integration/actuator-workflows.integration.js .integration-dist/integration/telemetry-persistence.integration.js .integration-dist/integration/actuator-task-persistence.integration.js .integration-dist/integration/cultivation-persistence.integration.js .integration-dist/integration/database-runtime.integration.js .integration-dist/integration/backup.integration.js .integration-dist/integration/demo-telemetry.integration.js .integration-dist/integration/operational-data.integration.js .integration-dist/integration/rich-data.integration.js .integration-dist/integration/pdf-business.integration.js .integration-dist/integration/ai.integration.js",
    "test:demo-telemetry": "tsc --outDir .integration-dist && node --test .integration-dist/integration/demo-telemetry.integration.js",
    "test:backup": "tsc --outDir .integration-dist && node --test .integration-dist/integration/backup.integration.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.0",
    "mongodb": "^6.21.0",
    "mqtt": "5.16.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "mqtt-packet": "9.0.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
