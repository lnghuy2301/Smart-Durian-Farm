NODE_ENV=development
# development defaults to database; test fixtures default to memory. No auto migration/seed at startup.
BUSINESS_STORAGE=database
PORT=3000
CORS_ORIGINS=http://localhost:5173
POSTGRES_USER=smart_durian
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=smart_durian
DATABASE_URL=postgresql://smart_durian:local_development_only@127.0.0.1:5432/smart_durian
MONGODB_URI=mongodb://127.0.0.1:27017/smart_durian?replicaSet=rs0&directConnection=true
DB_TIMEOUT_MS=3000
AUTH_MODE=mock
AUTH_TEST_PHONE=0900000000
AUTH_TEST_PASSWORD=LocalTestOnly123!
JWT_SECRET=local-test-only-secret-change-this-32-bytes-minimum
SMS_PROVIDER=mock
# Twilio Verify: điền 3 giá trị từ Console vào .env local, không đưa lên Git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Sửa HTX: để trống để dùng chung Verify Service ở trên; có thể điền VA SID riêng.
TWILIO_HTX_VERIFY_SERVICE_SID=
# Các số tài khoản Manager được phép nhận SMS, phân cách dấu phẩy (tối đa 20).
HTX_SMS_ALLOWED_PHONES=
# SpeedSMS được giữ cho tương thích nhánh cũ; demo hiện tại dùng Twilio Verify.
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SMS_TYPE=4
SPEEDSMS_SENDER=Verify
SMS_ALLOWED_PHONE=
LIVE_SMS_ENABLED=false
SMS_TIMEOUT_MS=10000

# Admin giả lập để duyệt Manager; không đăng ký Admin qua API công khai.
AUTH_TEST_ADMIN_PHONE=0900000001
AUTH_TEST_ADMIN_PASSWORD=LocalAdminOnly123!

# Email thật: điền SMTP_USER/PASSWORD/FROM rồi chuyển EMAIL_PROVIDER=smtp.
EMAIL_PROVIDER=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# MQTT communication: disabled until the operator configures a broker in local .env.
# Resolve every incoming station from the shared Devices store.
MQTT_ENABLED=false
MQTT_BROKER_HOST=<mqtt-broker-host>
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
# Connectivity display threshold only; not an actuator task timeout.
MQTT_OFFLINE_AFTER_MS=1800000
MQTT_RECONNECT_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000

# Hardware receipt ACK timeout PER relay step; independent of connection/presence timers.
ACTUATOR_ACK_TIMEOUT_MS=10000

# Demo profile: db:seed registers this ESP32 identifier with its UUID/Zone mapping.
# API startup does not auto-register a Device or restrict MQTT to this station.
DEMO_DEVICE_STATION_ID=
# Installation metadata read by db:seed; API runtime uses the configured database.
# Illustrative values approved for demo, not a claim about actual installation/invoice.
DEMO_DEVICE_INSTALLED_AT=2026-09-01T08:30:00+07:00
DEMO_DEVICE_COST=10237500

# Public web origin encoded in Tree QR, not the API/broker URL. No path or credentials.
# Local browser demo; change to your reachable web origin for phone/domain testing.
TRACE_PUBLIC_BASE_URL=http://localhost:5173

# Four account groups only: owner/admin above, assigned Farmer and future real Manager below.
# Other account credentials belong in docs/LOCAL_MODULE_ACCEPTANCE.private.md (Git ignored).
# References do not create accounts, reset passwords or grant permissions.
REFERENCE_FARMER_NAME=
REFERENCE_FARMER_PHONE=
REFERENCE_FARMER_PASSWORD=
REFERENCE_MANAGER_NAME=
REFERENCE_MANAGER_PHONE=
REFERENCE_MANAGER_EMAIL=
REFERENCE_MANAGER_PASSWORD=
# AI: local Python worker; classifier uses ai/models/disease/best.pt.
# Keep internal token and provider keys private; never use VITE_ for keys.
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8001
AI_INTERNAL_TOKEN=
AI_CHAT_PROVIDER=groq
AI_DEVICE=cpu
# Without a key, chatbot stays unavailable and the rest of the API still starts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=4096
# Active chatbot provider. Enter your own Groq key on the server only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_OUTPUT_TOKENS=4096
